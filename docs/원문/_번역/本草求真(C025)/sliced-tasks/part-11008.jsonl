{"source_id": "C025:p003:s0004:c0003:t0068", "parent_source_id": "C025:p003:s0004:c0003", "chunk_index": 3, "chunk_count": 4, "book": "本草求真", "heading": "六淫病症主藥", "source_path": "C/C025.txt", "text": "\n\n涼血則以生地紅花紫草為最。凡赤芍地榆槐角側柏葉銀柴胡蒲公英卷柏等藥皆屬涼類。仍須看其兼症兼脈以審。", "target_original": "本草求真(C025)/003-下編.md", "translation_chunk_index": 68, "translation_chunk_count": 107, "sentence_count": 3}
